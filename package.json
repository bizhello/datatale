{
  "name": "datatale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "architecture": "steiger ./src --fail-on-warnings",
    "typecheck": "next typegen && tsc --noEmit",
