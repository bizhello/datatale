# Server-only configuration. Copy this file to the ignored .env.local file.
# Never use NEXT_PUBLIC_ for these values or connect local development to production storage.
# Full analysis/history/chat requires DATABASE_URL, gateway values, SESSION_PASSWORD,
# RATE_LIMIT_SALT, and positive analysis ceilings. See README.md for setup.
# Neon pooled connection string for a separate development project or branch.
DATABASE_URL=
# OpenAI-compatible gateway. A ChatGPT subscription is not an API credential.
OPENAI_BASE_URL=https://ai-gateway.spiro.vc/v1
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-terra
# Optional model for the combined text-report proposal; defaults to the faster model below.
AI_TEXT_MODEL=gpt-5.6-luna
# Generate independent random values of at least 32 characters for these secrets.
SESSION_PASSWORD=
RATE_LIMIT_SALT=
# Required only by the scheduled /api/cron/cleanup endpoint.
CRON_SECRET=
# Broader anti-abuse ceiling for free workspaces behind one IP.
ANALYSIS_IP_DAILY_LIMIT=20
ANALYSIS_GLOBAL_DAILY_LIMIT=100
# Required only for access-code unlock. Use unpadded base64url encoding of at least
# 32 random bytes, keep the stable seed server-only, and derive today's code with
# `bun run access:code`. The README contains a command that generates all secrets.
ANALYSIS_INVITE_CODE_SEED=
