# Server-only analysis configuration. Never use NEXT_PUBLIC_ for these values.
# Keep local values in .env.local and use isolated non-production storage.
DATABASE_URL=
OPENAI_BASE_URL=https://ai-gateway.spiro.vc/v1
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-terra
SESSION_PASSWORD=
RATE_LIMIT_SALT=
CRON_SECRET=
# Broader anti-abuse ceiling for free workspaces behind one IP.
ANALYSIS_IP_DAILY_LIMIT=20
ANALYSIS_GLOBAL_DAILY_LIMIT=100
# Generate once with `bun -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'`.
# Keep this seed server-only. `bun run access:code` derives today's code.
ANALYSIS_INVITE_CODE_SEED=
