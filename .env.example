# Server-only analysis configuration. Never use NEXT_PUBLIC_ for these values.
# Keep local values in .env.local and use isolated non-production storage.
DATABASE_URL=
OPENAI_BASE_URL=https://ai-gateway.spiro.vc/v1
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-terra
SESSION_PASSWORD=
RATE_LIMIT_SALT=
CRON_SECRET=
ANALYSIS_WORKSPACE_DAILY_LIMIT=1
# Keep this at 1 in production: it is the cookie-loss-resistant anonymous trial cap.
ANALYSIS_IP_DAILY_LIMIT=1
ANALYSIS_CODE_DAILY_LIMIT=10
ANALYSIS_GLOBAL_DAILY_LIMIT=100
# Comma-separated SHA-256 hashes of invite codes. Generate locally; copy only
# the hash into this env file and keep the printed code out of commits and logs:
# node -e 'const c=require("node:crypto"),s=c.randomBytes(32).toString("base64url"); console.log(`code=${s}`); console.log(`sha256=${c.createHash("sha256").update(s).digest("hex")}`)'
ANALYSIS_INVITE_CODE_HASHES=
